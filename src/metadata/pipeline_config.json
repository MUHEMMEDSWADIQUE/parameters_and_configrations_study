{
  "pipeline": {
    "name": "parameter_lab_pipeline",
    "description": "Parameter Lab SDP pipeline demonstrating parameter passing across SQL and Python",
    "layers": ["bronze", "silver", "gold"]
  },
  "environments": {
    "dev": {
      "catalog": "main",
      "schema": "parameter_lab_dev",
      "processing_mode": "incremental",
      "max_files_per_trigger": 50,
      "retention_days": 7,
      "enable_quality_checks": true,
      "cluster": {
        "min_instances": 1,
        "max_instances": 2
      }
    },
    "test": {
      "catalog": "main",
      "schema": "parameter_lab_test",
      "processing_mode": "incremental",
      "max_files_per_trigger": 100,
      "retention_days": 30,
      "enable_quality_checks": true,
      "cluster": {
        "min_instances": 1,
        "max_instances": 3
      }
    },
    "prod": {
      "catalog": "main",
      "schema": "parameter_lab_prod",
      "processing_mode": "full",
      "max_files_per_trigger": 500,
      "retention_days": 365,
      "enable_quality_checks": true,
      "cluster": {
        "min_instances": 2,
        "max_instances": 5
      }
    }
  },
  "workflow": {
    "name": "parameter_lab_job",
    "tasks": [
      {
        "task_key": "task_a_producer",
        "description": "Reads metadata and produces task values",
        "publishes": ["source_table", "load_type", "watermark", "processing_date", "source_path", "domain"]
      },
      {
        "task_key": "task_b_consumer",
        "description": "Consumes Task A values and publishes transformed values",
        "depends_on": ["task_a_producer"],
        "publishes": ["target_table", "watermark_value", "processing_config"]
      },
      {
        "task_key": "task_c_task_values",
        "description": "Demonstrates advanced task value patterns",
        "depends_on": ["task_b_consumer"],
        "publishes": ["processing_manifest", "manifest_id"]
      },
      {
        "task_key": "task_d_dynamic_params",
        "description": "Parses JSON config and generates dynamic parameters",
        "depends_on": ["task_c_task_values"],
        "publishes": ["dynamic_sql", "unified_config", "pipeline_params"]
      },
      {
        "task_key": "task_e_pipeline",
        "description": "Triggers the SDP pipeline",
        "depends_on": ["task_d_dynamic_params"],
        "publishes": []
      }
    ]
  },
  "json_config_template": {
    "source": "azure_sql",
    "schema": "retail",
    "table": "customer",
    "load_type": "incremental",
    "watermark_column": "modified_date",
    "options": {
      "partition_column": "country",
      "max_files": 100,
      "quality_check": true
    }
  }
}